# Fyers API credentials for the DOR app.
#
# Local:  copy this to .streamlit/secrets.toml (gitignored) — or just keep
#         using fyers_credentials.json, the app reads either.
# Hosted: paste the [fyers] block into the Streamlit Cloud app's
#         Settings -> Secrets box. There is no file to upload.
#
# Only the three PERMANENT values belong here. The access_token is NOT listed:
# it expires at 06:00 every morning and is minted through the sidebar's Fyers
# login, then held in the app's memory. Putting a token here would mean editing
# secrets every single day, and it would be stale within hours.

[fyers]
client_id    = "GS24C9E4A6-100"
secret_key   = "4E89VKY72C"
redirect_uri = "https://trade.fyers.in/api-login/redirect-uri/index.html"
